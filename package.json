{
  "name": "saiyan-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "reindex": "tsx server/scripts/reindex.ts",
    "import:intel": "tsx server/scripts/import-intel.ts",
    "validate:vault": "tsx server/scripts/validate-vault.ts",
    "digest": "tsx server/scripts/digest.ts",
    "research:daily": "tsx server/scripts/daily-research.ts",
    "pin:hash": "tsx server/scripts/hash-pin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.4.3",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.4.3",
    "chokidar": "^4.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "mysql2": "^3.14.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
