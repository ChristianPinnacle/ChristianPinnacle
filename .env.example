# Database (optional for Task 1 — required from Task 2 onward)
DATABASE_URL=mysql://root:password@localhost:3306/saiyan_archive

# Server
PORT=3001
# Comma-separate to allow both a Railway URL and a custom domain.
# In production this must match the browser origin exactly (cookies + CORS).
CLIENT_ORIGIN=http://localhost:5174
# NODE_ENV=production

# Optional path overrides (defaults are relative to the working directory)
# VAULT_DIR=/app/vault
# VAULT_SEED_DIR=/app/vault-seed

# AI (Phase 2+ — required for Scouter RAG chat)
# ANTHROPIC_API_KEY=sk-ant-...
# VOYAGE_API_KEY=pa-...   # Anthropic-recommended embeddings (https://dash.voyageai.com)
# EMBED_FREE_TIER=1       # Pace full reindex for Voyage free-tier limits

# Optional backlog features
# INBOX_SECRET=long-random-string   # enables POST /inbox for agents/shortcuts
# TAVILY_API_KEY=tvly-...           # enables RESEARCH mode web search

# Phase 5 — PIN lock (generate with: npx tsx server/scripts/hash-pin.ts 1234)
# APP_PIN_HASH=scrypt$...
# SESSION_SECRET=long-random-string

# Railway: mount a persistent volume at /app/vault.
# The image seeds it from /app/vault-seed only when it has no markdown notes.

# Vault -> private Git mirror (off unless VAULT_GIT_SYNC=1).
# One-time setup: make the vault dir a git repo with the remote reachable,
# then set VAULT_GIT_DRY_RUN=1 first to confirm before pushing for real.
# VAULT_GIT_SYNC=1
# VAULT_GIT_DRY_RUN=1
# VAULT_GIT_REMOTE=https://<token>@github.com/<you>/<private-vault>.git
# VAULT_GIT_BRANCH=main
# VAULT_GIT_AUTHOR_NAME=Saiyan Archive
# VAULT_GIT_AUTHOR_EMAIL=archive@localhost
